    },
    {
      "name": "citybuddy_agent_faq_cache_lookups_total",
      "type": "counter",
      "unit": "lookups",
      "description": "Terminal FAQ cache observations at each reached layer.",
      "labelNames": ["level", "result"],
      "allowedLabelSets": [
        {"level": "mapping", "result": "hit"},
        {"level": "mapping", "result": "miss"},
        {"level": "mapping", "result": "bypass"},
        {"level": "mapping", "result": "unavailable"},
        {"level": "mapping", "result": "invalid"},
        {"level": "answer", "result": "hit"},
        {"level": "answer", "result": "miss"},
        {"level": "answer", "result": "invalid"}
      ],
      "producerIds": ["agent.faq_cache_lookup"],
      "cb152Usage": "Separate mapping and answer hit rates use hit/(hit+miss)."
    },
    {
      "name": "citybuddy_knowledge_backend_decisions_total",
      "type": "counter",
      "unit": "decisions",
      "description": "Completed FAQ-cache versus issued Elasticsearch backend choices.",
      "labelNames": ["decision"],
      "allowedLabelSets": [
        {"decision": "cache_served"},
        {"decision": "elasticsearch_issued"}
      ],
      "producerIds": ["agent.knowledge_backend_choice"],
      "cb152Usage": "Elasticsearch avoidance uses cache_served/(cache_served+elasticsearch_issued)."
    },
    {
      "name": "citybuddy_agent_model_request_attempts_total",
      "type": "counter",
      "unit": "attempts",
      "description": "Actual outbound model HTTP attempts by positional role and bounded outcome.",
      "labelNames": ["role", "outcome"],
      "allowedLabelSets": [
        {"role": "primary", "outcome": "success"},
        {"role": "primary", "outcome": "transient"},
        {"role": "primary", "outcome": "denied"},
        {"role": "primary", "outcome": "invalid"},
        {"role": "primary", "outcome": "error"},
        {"role": "fallback", "outcome": "success"},
        {"role": "fallback", "outcome": "transient"},
        {"role": "fallback", "outcome": "denied"},
        {"role": "fallback", "outcome": "invalid"},
        {"role": "fallback", "outcome": "error"},
        {"role": "reranker", "outcome": "success"},
        {"role": "reranker", "outcome": "transient"},
        {"role": "reranker", "outcome": "denied"},
        {"role": "reranker", "outcome": "invalid"},
        {"role": "reranker", "outcome": "error"}
      ],
      "producerIds": ["agent.provider_http_attempt"],
      "cb152Usage": "Diagnostics only; never a cache-saving formula."
    },
    {
      "name": "citybuddy_agent_trace_exports_total",
      "type": "counter",
      "unit": "exports",
      "description": "Enabled custom trace mirror export results.",
      "labelNames": ["outcome"],
      "allowedLabelSets": [
        {"outcome": "sent"},
        {"outcome": "failed"},
        {"outcome": "dropped"}
      ],
      "producerIds": ["agent.trace_export"],
      "cb152Usage": "Diagnostic custom trace mirror delivery only."
    }
  ],
  "formulas": [
    {
      "name": "mapping_faq_hit_rate",
      "numerator": "mapping:hit",
      "denominator": "mapping:hit + mapping:miss",
      "excludedOutcomes": ["bypass", "unavailable", "invalid"]
    },
    {
      "name": "answer_faq_hit_rate",
      "numerator": "answer:hit",
      "denominator": "answer:hit + answer:miss",
      "excludedOutcomes": ["bypass", "unavailable", "invalid"]
    },
    {
      "name": "elasticsearch_knowledge_search_avoidance",
      "numerator": "cache_served",
      "denominator": "cache_served + elasticsearch_issued",
      "excludedOutcomes": []
    }
  ]
}
